#!/usr/bin/env python3.12
"""Bootstrap the stdlib-only Vanilla tooling without uv or site packages."""

from __future__ import annotations

import sys

if sys.version_info[:2] != (3, 12):
    print(
        f"scripts/vanilla requires Python 3.12; found {sys.version.split()[0]}",
        file=sys.stderr,
    )
    raise SystemExit(2)

from bbb_tools.vanilla.cli import main

raise SystemExit(main())
