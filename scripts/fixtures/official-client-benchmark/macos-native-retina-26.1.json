      "gpu_duration": [
        "p99_ms",
        "hitch_counts"
      ],
      "input_latency": [
        "mean_ms",
        "p50_ms",
        "p95_ms",
        "p99_ms",
        "hitch_counts",
        "sample_count",
        "superseded_events",
        "out_of_order_events"
      ]
    },
    "diagnostic_metrics": {
      "application_frame_time": [
        "p50_ms",
        "p95_ms",
        "stddev_ms",
        "p99_minus_p50_ms",
        "coefficient_of_variation"
      ],
      "gpu_duration": [
        "mean_ms",
        "p50_ms",
        "p95_ms",
        "stddev_ms",
        "p99_minus_p50_ms",
        "coefficient_of_variation"
      ],
      "input_latency": [
        "stddev_ms",
        "p99_minus_p50_ms"
      ]
    }
  },
