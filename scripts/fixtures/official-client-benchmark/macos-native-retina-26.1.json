  "formal_order": [
    "vanilla",
    "bbb",
    "bbb",
    "vanilla",
    "vanilla",
    "bbb",
    "bbb",
    "vanilla"
  ],
  "capture_segments": [
    "static_orbit",
    "preloaded_flight",
    "chunk_boundary_crossing"
  ],
  "input_at_each_capture_start": [
    "F2",
    "F3-down",
    "L-down",
    "L-up",
    "F3-up"
  ],
  "drawable_mismatch_policy": "block-without-comparison",
  "candidate_bbb_ab": {
    "schema": "macos-native-retina-bbb-ab-v3",
