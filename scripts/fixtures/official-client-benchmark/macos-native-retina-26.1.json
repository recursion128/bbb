    "required_client": "bbb",
    "correlation_target": "application_frame_interval",
    "primary_correlation": "phase[n]-to-interval[n+1]",
    "phase_to_interval_lag_frames": 1
  },
  "frame_flight_diagnostics": {
    "schema": "renderer-frame-flight-v1",
