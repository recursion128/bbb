  "scope_ruling": {
    "classification": "not-needed-declared-linux-wayland",
    "final_conclusion": "On official Java 25, GLFW paths are NUL-terminated before LWJGL's Java-11 multi-release UTF-8 decoder replaces malformed input. The resulting valid Java String cannot trigger UnixPath's NUL or malformed-UTF-16 rejection, so failedCount remains zero on Linux/Wayland. The only onFilesDrop override is PackSelectionScreen, excluded by the command-line-only configuration scope.",
    "predicates": [
      "official runtime major version is Java 25",
      "GLFWDropCallback.getName uses NUL-terminated MemoryUtil.memUTF8",
      "Java 25 selects LWJGL's versions/25 MemoryUtil and versions/11 UTF-8 decoder",
      "the selected decoder uses StandardCharsets.UTF_8 replacement semantics",
      "UnixPath rejects NUL or malformed UTF-16, neither of which survives that chain",
      "Screen.onFilesDrop is empty and PackSelectionScreen is the only override"
    ],
    "reopen_condition": "The official Java/LWJGL/GLFW/JDK conversion chain changes, a supported platform can produce InvalidPathException, BBB adds PackSelectionScreen or another onFilesDrop consumer, or the declared platform/configuration scope changes.",
    "reproduce_command": "scripts/python scripts/generate-file-drop-capability.py --vanilla-root \"$(scripts/vanilla path 26.1 --kind root)\" --check"
  },
