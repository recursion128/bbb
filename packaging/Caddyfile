# Caddy reverse-proxy recipe for bbb-web-host.
# Terminates HTTPS (required by browsers for SharedArrayBuffer + WebGPU outside
# localhost), enforces COOP/COEP/CORP cross-origin isolation, proxies `/ws`
# binary WebSocket traffic to the loopback bbb-web-host service, and blocks the
# local-only `/control-ws` automation tunnel at the public edge.

play.example.com {
	@control_tunnel path /control-ws /control-ws/*
	respond @control_tunnel 403

	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Resource-Policy "same-origin"
	}

	reverse_proxy 127.0.0.1:8080 {
		header_down -Cross-Origin-Opener-Policy
		header_down -Cross-Origin-Embedder-Policy
		header_down -Cross-Origin-Resource-Policy
	}
}
